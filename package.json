{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format-import": "prettier --plugin @trivago/prettier-plugin-sort-imports --write 'app/**/*.vue'",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/eslint": "^1.17.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
